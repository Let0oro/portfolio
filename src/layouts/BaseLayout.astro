---
import NavOrnamental from "../components/NavOrnamental.astro";
import MagicParticles from "../components/MagicParticles.astro";
import "../styles/global.scss";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Developer Portfolio" } = Astro.props;
const canonicalUrl = Astro.url.href;
import { getLangFromUrl } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/x-icon"
      href={`${import.meta.env.BASE_URL}logo.ico`}
    />
    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}logo.png`}
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google Fonts: Cormorant Garamond & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <!-- Atmospheric overlays -->
    <div class="clouds-overlay" aria-hidden="true"></div>
    <div class="grunge-overlay" aria-hidden="true"></div>
    <div class="vignette-overlay" aria-hidden="true"></div>

    <MagicParticles />
    <NavOrnamental />
    <main>
      <slot />
    </main>
  </body>
</html>
